# Allow-list: only what the image needs. Credentials, listing settings,
# private reports and media never enter the build context.
*
!Dockerfile
!prompt/
prompt/*
!prompt/AGENTS.md
!skills/
skills/*
!skills/mac-health/
skills/mac-health/*
!skills/mac-health/SKILL.md
!skills/mac-health/scripts/
!native/
native/*
!native/mac_guardian.py
!native/workspace_care.py
!scripts/
scripts/*
!scripts/install_native.py
!runtime/
runtime/*
!runtime/healthcheck.mjs
plow-credentials
private
.env
listing.json
agent.env
**/__pycache__
